<Window x:Class="NexusContacts.ShowAllContacts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexusContacts"
        mc:Ignorable="d"
        Title="ShowAllContacts" Height="450" Width="800">
    <Grid Margin="10">
        <DataGrid x:Name="dgContacts" 
              CanUserAddRows="False" 
              MouseDoubleClick="EditCont"
              HeadersVisibility="Column" 
              IsReadOnly="True"
              Margin="20"
              FontSize="20"
              GridLinesVisibility="Horizontal"
              Background="White"
              AlternatingRowBackground="#F2F2F2"
              BorderBrush="LightGray"
              BorderThickness="1">

        </DataGrid>
    </Grid>
</Window>
    