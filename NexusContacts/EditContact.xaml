<Window x:Class="NexusContacts.EditContactWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexusContacts"
        mc:Ignorable="d"
        Title="EditContact" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Edit Contact" 
                   FontSize="30" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Grid.ColumnSpan="2" FontWeight="Bold"/>

        <Grid Grid.Row="1" Grid.Column="0" Margin="10">
            <TextBox x:Name="txtFirstName" FontSize="18" VerticalContentAlignment="Center" Padding="5"/>
            <TextBlock Text="{Binding Fname}" FontSize="18" Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtFirstName}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock x:Name="ContactID" 
                   FontSize="25"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Grid.Row="1" Grid.Column="1">
            <TextBlock.Text>
                <Binding Path="NextContactID" StringFormat="ID: {0}"/>
            </TextBlock.Text>
        </TextBlock>

        <Grid Grid.Row="2" Grid.Column="0" Margin="10">
            <TextBox x:Name="txtLastName" FontSize="18" VerticalContentAlignment="Center" Padding="5"/>
            <TextBlock Text="{Binding Lname}" FontSize="18" Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtLastName}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="1" Margin="10">
            <TextBox x:Name="txtPhone" FontSize="18" VerticalContentAlignment="Center" Padding="5"/>
            <TextBlock Text="Phone Number" FontSize="18" Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtPhone}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="0" Margin="10">
            <TextBox x:Name="txtAge" FontSize="18" VerticalContentAlignment="Center" Padding="5"/>
            <TextBlock Text="Age" FontSize="18" Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtAge}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0">
            <CheckBox x:Name="chkIsFavorite" VerticalAlignment="Center">
                <CheckBox.RenderTransform>
                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                </CheckBox.RenderTransform>
            </CheckBox>
            <TextBlock Text="Add to Favorites" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="DarkSlateBlue"/>
        </StackPanel>

    </Grid>
</Window>
